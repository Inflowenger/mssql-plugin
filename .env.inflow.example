# Copy to .env.inflow and fill in.
#
# This file carries the plugin's PLATFORM identity only — the values Infra hands
# out when the plugin is provisioned in a space.
#
# SQL Server credentials are deliberately NOT here. They are a settings profile:
# the platform stores what the plugin's set-up form asks for and ships it with
# every call as body.settings, so one running plugin can serve many databases
# and rotating a password needs no redeploy.

PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=LS0tLS1CRUdJTiBOQVRTIFVTRVIgSldULS0t...   # base64 of the .creds blob
INFRA_URL=localhost:4222

# Optional: read a different dotenv (default .env.inflow)
# INFLOW_ENV_FILE=.env.inflow.staging
